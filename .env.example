# Equity Research Generator - Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# REQUIRED - API Keys
# ===========================================

# Anthropic Claude API Key (for AI analysis)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Secret key for JWT tokens (use a long random string)
SECRET_KEY=your-secret-key-at-least-32-characters-long

# ===========================================
# REQUIRED FOR GOOGLE LOGIN - OAuth Settings
# ===========================================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth callback URL (must match what's configured in Google Cloud Console)
# Local development:
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Production (Render):
# GOOGLE_REDIRECT_URI=https://your-api.onrender.com/api/auth/google/callback

# Frontend URL for OAuth redirects (where to redirect after OAuth callback)
# Local development (default - no need to set):
# FRONTEND_URL=http://localhost:8000/static
# Production (Render) - set this in Render dashboard:
# FRONTEND_URL=https://your-frontend.onrender.com

# ===========================================
# OPTIONAL - Override defaults
# ===========================================

# Python version (for Render deployment)
# PYTHON_VERSION=3.11.0
